#!/usr/bin/env bash
# body, the wrapper I use to talk to the Body bridge (com.beqa.body) from inside the proot.
# Talks to the loopback accessibility bridge; no ADB in the control loop.
set -u
BASE="${BODY_BASE:-http://127.0.0.1:8765}"
TOKENFILE="${BODY_TOKEN_FILE:-/data/data/com.termux/files/home/.config/body/bridge_token}"
TOK="$(cat "$TOKENFILE" 2>/dev/null)"

_get() { curl -s -m 20 -H "Authorization: Bearer $TOK" "$BASE$1"; }
_post() { curl -s -m 30 -H "Authorization: Bearer $TOK" -H "Content-Type: application/json" -X POST "$BASE$1" -d "${2:-}"; }
# url-encode a string
_enc() { python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"; }

# pretty-print a read_screen / find_nodes element list
_pp() {
local raw; raw="$(cat)"
BODY_JSON="$raw" python3 <<'PY'
import os,json,sys
raw=os.environ.get("BODY_JSON","")
try: d=json.loads(raw)
except Exception:
    print(raw or "(empty response)"); raise SystemExit
if not d.get("ok", True):
    print(json.dumps(d, indent=2)); sys.exit(0)
app=d.get("app",""); h=d.get("screen_hash",""); g=d.get("generation","")
els=d.get("elements") or d.get("matches") or []
print(f"# app={app}  hash={h}  gen={g}  ({len(els)} elements)")
for e in els:
    i=e.get("id","?"); role=e.get("role","")
    label=e.get("text") or e.get("desc") or ""
    rid=e.get("rid",""); st=e.get("state","")
    rid=rid.split("/")[-1] if rid else ""
    extra=" ".join(x for x in [f'#{rid}' if rid else '', f'[{st}]' if st else ''] if x)
    lbl=f' "{label}"' if label else ""
    print(f"  {str(i):>3}  {role:<14}{lbl}  {extra}".rstrip())
PY
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  health)  _get /health; echo ;;
  state)   _get /state | python3 -m json.tool ;;
  screen)  mode="interactive"; [ "${1:-}" = "full" ] && mode="full"; _get "/read_screen?mode=$mode" | _pp ;;
  find)    _get "/find_nodes?text=$(_enc "$1")&limit=${2:-20}" | _pp ;;
  desc)    _get "/describe_node?id=$1" | python3 -m json.tool ;;
  diff)    _get "/screen_diff?hash=${1:-}" | python3 -m json.tool ;;
  tap)     _get "/tap?id=$1" | python3 -m json.tool ;;
  tapxy)   _get "/tap?x=$1&y=$2" | python3 -m json.tool ;;
  long)    _get "/long_press?id=$1" | python3 -m json.tool ;;
  type)    if [ "${1:-}" = "-i" ]; then id="$2"; shift 2; _get "/type_text?id=$id&text=$(_enc "$*")" | python3 -m json.tool
           else _get "/type_text?text=$(_enc "$*")" | python3 -m json.tool; fi ;;
  scroll)  _get "/scroll?direction=${1:-down}${2:+&id=$2}" | python3 -m json.tool ;;
  swipe)   _get "/swipe?direction=${1:-up}" | python3 -m json.tool ;;
  key)     _get "/press_key?key=$1" | python3 -m json.tool ;;
  notifs)  _get "/notifications?limit=${1:-50}" | python3 -m json.tool ;;
  launch)  _post /launch "{\"pkg\":\"$1\"}" | python3 -m json.tool ;;
  open)    _post /launch "{\"url\":\"$1\"}" | python3 -m json.tool ;;
  apps)    _get "/list_apps${1:+?filter=$(_enc "$1")}" | python3 -m json.tool ;;
  current) _get /current_app | python3 -m json.tool ;;
  wait)    _get "/wait_for?text=$(_enc "$1")&timeout=${2:-5000}" | python3 -m json.tool ;;
  raw)     _get "$1" ; echo ;;
  rawpost) _post "$1" "${2:-}" ; echo ;;
  help|*)  cat <<EOF
body: drive the phone through the Body bridge
  screen [full]        read the screen (numbered, tappable elements)
  find <text> [limit]  find nodes by text
  desc <id>            details for one element
  diff [hash]          what changed since a hash
  tap <id> | tapxy x y | long <id>
  type [-i <id>] <text...>
  scroll <up|down|left|right> [id] | swipe <dir> | key <back|home|recents|notifications|quick_settings|lock_screen>
  launch <pkg> | open <url> | apps [filter] | current
  notifs [limit] | wait <text> [ms]
  state | health | raw <path> | rawpost <path> [json]
EOF
  ;;
esac
